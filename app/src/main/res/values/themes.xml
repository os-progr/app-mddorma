<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (dark) -->
    <style name="Theme.MDDorma" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#A855F7</item>
        <item name="android:colorPrimaryDark">#1A0A2E</item>
        <item name="android:colorAccent">#D946EF</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- Splash screen theme with purple gradient -->
    <style name="Theme.MDDorma.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#1A0A2E</item>
        <item name="android:navigationBarColor">#4A1A8A</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>